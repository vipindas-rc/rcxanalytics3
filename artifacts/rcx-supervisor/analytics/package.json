{
  "name": "@workspace/analytics-content",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "node scripts/require-test-database.mjs && node --import tsx node_modules/vitest/vitest.mjs run tests/integration",
    "test:examples": "node scripts/require-synthetic-test-database.mjs && node --import tsx node_modules/vitest/vitest.mjs run server/examples/service.test.ts",
    "test:deterministic": "vitest run src server evaluation",
    "test:gateway": "node --import tsx scripts/gateway-test.ts",
    "eval:dry-run": "tsx evaluation/cli.ts --dry-run",
    "eval:live": "tsx evaluation/cli.ts --live",
    "start": "tsx --env-file=.env server/index.ts",
    "db:migrate": "tsx --env-file=.env server/db/cli.ts",
    "db:seed": "tsx --env-file=.env server/db/cli.ts --seed",
    "db:examples:migrate": "tsx --env-file=.env server/db/examplesCli.ts",
    "db:examples:seed": "tsx --env-file=.env server/db/examplesCli.ts --seed",
    "demo:export": "tsx server/demo/seedCli.ts export",
    "demo:restore": "tsx server/demo/seedCli.ts restore"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.153.4",
    "@ringcentral/spring-base": "1.11.2",
    "@ringcentral/spring-icon": "1.11.2",
    "@ringcentral/spring-theme": "1.11.2",
    "@ringcentral/spring-ui": "1.11.2",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.20",
    "chart.js": "4.5.1",
    "dayjs": "1.11.13",
    "echarts": "6.1.0",
    "express": "5.1.0",
    "flint-chart": "0.5.1",
    "pg": "^8.23.0",
    "plotly.js-dist-min": "3.0.0",
    "postcss": "^8.4.49",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-virtuoso": "4.7.10",
    "tailwindcss": "3.4.12",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.0.8"
  }
}
